# ==============================================================================
# ReachInbox.ai Full-Stack Email Job Scheduler - Environment Configuration
# ==============================================================================

# Server & URLs
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Session Secret (used for express-session cookie encryption)
SESSION_SECRET=super-secure-session-secret-change-in-production-reachinbox-2026

# Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/reachinbox_scheduler?schema=public

# Queue & Cache (Redis)
# Format: redis://[host]:[port]
REDIS_URL=redis://localhost:6379

# Search Engine (Elasticsearch)
# Format: http://[host]:[port]
ELASTICSEARCH_URL=http://localhost:9200

# Worker & Scheduling Defaults
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100

# Email Delivery (Ethereal SMTP via nodemailer)
# If left empty, the application will automatically generate a temporary Ethereal test account on launch.
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=litzy.nikolaus@ethereal.email
ETHEREAL_PASSWORD=ucDNfsaGMFMbZp2j4T

