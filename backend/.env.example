# Server & URLs
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Session Secret (used for express-session cookie encryption)
SESSION_SECRET=super-secure-session-secret-change-in-production-reachinbox-2026

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/reachinbox_scheduler?schema=public

# Queue & Cache (Redis)
REDIS_URL=redis://localhost:6379

# Search Engine (Elasticsearch)
ELASTICSEARCH_URL=http://localhost:9200

# Worker & Scheduling Defaults
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100

# Email Delivery (Ethereal SMTP via nodemailer)
# If left empty, the application will automatically generate a temporary Ethereal test account on launch.
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=mock-google-client-id
GOOGLE_CLIENT_SECRET=mock-google-client-secret

# Slack OAuth Credentials
SLACK_CLIENT_ID=mock-slack-client-id
SLACK_CLIENT_SECRET=mock-slack-client-secret
